{
  "name": "scraperbase",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "cli": "node src/cli/index.ts",
    "migrate": "node src/scripts/migrate.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/**/*.test.ts",
    "web:dev": "node src/web/server.ts --dev",
    "web:build": "vite build",
    "web": "node src/web/server.ts",
    "psa:import": "node src/scripts/psa-backfill-import.ts",
    "psa:fetch-missing": "node src/scripts/psa-fetch.ts --from-db",
    "pokewiki:images": "node src/scripts/pokewiki-image-backfill.ts"
  },
  "dependencies": {
    "playwright": "^1.48.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.3",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.1",
    "typescript": "^5.7.0",
    "vite": "^8.2.2"
  }
}
